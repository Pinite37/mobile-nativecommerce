{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:production": "eas build --platform ios --profile production --auto-submit",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-webview"
      ]
    }
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@kkiapay-org/react-native-sdk": "^0.1.11",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.10.0",
    "expo": "~57.0.13",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "^4.5.1",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-international-phone-number": "0.11.10",
    "react-native-keyboard-controller": "^1.22.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-community/cli": "^20.0.2",
    "@types/react": "~19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "jimp": "^1.6.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
